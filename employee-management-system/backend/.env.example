# Copy this file to ".env" and fill in your own values

# Local MongoDB:      mongodb://127.0.0.1:27017/employee_management
# MongoDB Atlas:       mongodb+srv://<user>:<password>@cluster0.mongodb.net/employee_management
MONGO_URI=mongodb://127.0.0.1:27017/employee_management

PORT=5000

# OpenAI — keep this secret, never expose in frontend
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# AI model to use (gpt-4o-mini is fast and cost-effective)
OPENAI_MODEL=gpt-4o-mini