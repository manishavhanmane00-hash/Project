# Copy this file to ".env" and fill in your own values

# Local MongoDB:      mongodb://127.0.0.1:27017/employee_management
# MongoDB Atlas:       mongodb+srv://<user>:<password>@cluster0.mongodb.net/employee_management
MONGO_URI=mongodb://127.0.0.1:27017/employee_management

PORT=5000

# JWT — use a long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_random_64_char_secret
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 Web Client ID — required for Google Sign-In.
# This MUST be the same value as REACT_APP_GOOGLE_CLIENT_ID in frontend/.env
# because the backend verifies the token audience against this ID.
# Create one at https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID, "Web application").
# Authorized JavaScript origins: http://localhost:3000
GOOGLE_CLIENT_ID=

# Optional: CORS origin (default: http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# Initial admin seed — used ONLY by "npm run seed" once
SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_NAME=System Administrator
