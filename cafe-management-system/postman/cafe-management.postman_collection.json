{
  "info": {
    "_postman_id": "cafe-mgmt-001",
    "name": "Cafe Management System API",
    "description": "Complete API collection for Brew & Bite Cafe Management System. Import this into Postman and set the {{base_url}} variable to http://localhost:5000/api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000/api", "type": "string" },
    { "key": "user_token", "value": "", "type": "string" },
    { "key": "admin_token", "value": "", "type": "string" },
    { "key": "order_id", "value": "", "type": "string" },
    { "key": "menu_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup (New User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const res = pm.response.json();",
                  "  pm.collectionVariables.set('user_token', res.data.token);",
                  "  console.log('Token saved:', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/signup",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Customer\",\n  \"email\": \"customer@test.com\",\n  \"password\": \"Test@1234\"\n}"
            }
          }
        },
        {
          "name": "Login (User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const res = pm.response.json();",
                  "  pm.collectionVariables.set('user_token', res.data.token);",
                  "  console.log('User token saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@test.com\",\n  \"password\": \"Test@1234\"\n}"
            }
          }
        },
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const res = pm.response.json();",
                  "  pm.collectionVariables.set('admin_token', res.data.token);",
                  "  console.log('Admin token saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@cafe.com\",\n  \"password\": \"Admin@123\"\n}"
            }
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }]
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/logout",
            "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Menu",
      "item": [
        {
          "name": "Get All Menu (Public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const res = pm.response.json();",
                  "  if (res.data.length > 0) {",
                  "    pm.collectionVariables.set('menu_id', res.data[0]._id);",
                  "    console.log('Menu ID saved:', res.data[0]._id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/menu"
          }
        },
        {
          "name": "Get Single Category",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/menu/{{menu_id}}"
          }
        },
        {
          "name": "Create Category (Admin)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/menu",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"Pasta\",\n  \"icon\": \"🍝\",\n  \"description\": \"Italian pasta dishes\",\n  \"subItems\": [\n    {\n      \"name\": \"Pasta Alfredo\",\n      \"description\": \"Creamy white sauce pasta\",\n      \"price\": 199\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Add Sub-item (Admin)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/menu/{{menu_id}}/subitems",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Special Pizza\",\n  \"description\": \"Chef's special creation\",\n  \"price\": 299,\n  \"image\": \"https://via.placeholder.com/300x200\"\n}"
            }
          }
        },
        {
          "name": "Delete Category (Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/menu/{{menu_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const res = pm.response.json();",
                  "  pm.collectionVariables.set('order_id', res.data._id);",
                  "  console.log('Order ID saved:', res.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/orders",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"menuItemId\": \"REPLACE_WITH_MENU_CATEGORY_ID\",\n      \"subItemId\": \"REPLACE_WITH_SUBITEM_ID\",\n      \"quantity\": 2\n    }\n  ],\n  \"paymentMethod\": \"Cash\",\n  \"notes\": \"Extra spicy please\"\n}"
            }
          }
        },
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders/my",
            "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }]
          }
        },
        {
          "name": "Track Order",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders/{{order_id}}/track",
            "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }]
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders/{{order_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }]
          }
        },
        {
          "name": "Update Order Status (Admin)",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/orders/{{order_id}}/status",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Preparing\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Razorpay Order",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/payments/create-order",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{order_id}}\"\n}"
            }
          }
        },
        {
          "name": "Verify Razorpay Payment",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/payments/verify",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"razorpayOrderId\": \"order_XXXXXXXXXX\",\n  \"razorpayPaymentId\": \"pay_XXXXXXXXXX\",\n  \"razorpaySignature\": \"signature_hash\",\n  \"cafeOrderId\": \"{{order_id}}\",\n  \"method\": \"Razorpay\"\n}"
            }
          }
        },
        {
          "name": "Record Manual Payment (Cash/UPI/etc)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/payments/manual",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cafeOrderId\": \"{{order_id}}\",\n  \"method\": \"UPI\"\n}"
            }
          }
        },
        {
          "name": "Get Payment Receipt",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/payments/receipt/{{order_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/dashboard",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        },
        {
          "name": "All Orders (with filters)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/admin/orders?page=1&limit=10&status=Placed",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "Placed", "description": "Placed|Preparing|Ready|Out for Delivery|Completed|Cancelled" },
                { "key": "date", "value": "", "disabled": true, "description": "YYYY-MM-DD" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        },
        {
          "name": "All Payments",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/admin/payments?page=1&limit=10",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "method", "value": "", "disabled": true, "description": "Cash|UPI|GPay|PhonePe|Bank Transfer|Razorpay" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        },
        {
          "name": "Login Activity Logs",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/login-logs?page=1&limit=20",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        },
        {
          "name": "All Customers",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/users",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "item": [
        {
          "name": "API Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        }
      ]
    }
  ]
}
