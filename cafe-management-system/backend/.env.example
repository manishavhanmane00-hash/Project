# MongoDB connection
# Local example: mongodb://localhost:27017/cafe_management
# Atlas example: mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/cafe_management?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/cafe_management

# JWT config
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRE=7d

# Server config
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Razorpay keys
# Get these from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# Default admin user used by seed script
ADMIN_EMAIL=admin@cafe.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Cafe Admin
